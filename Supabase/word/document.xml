.team_id</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t xml:space="preserve">    where t.manager_id = auth.uid() and tm.user_id = target_user_id</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t xml:space="preserve">  );</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>$$ language sql security definer;</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>-- POLICIES CHO BẢNG LEADS</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>-- 1. Admin: Xem tất cả</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>create policy "Admins can do everything on leads"</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t xml:space="preserve">  on public.leads for all</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t xml:space="preserve">  using (is_admin());</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>-- 2. Sales: Chỉ xem lead mình được giao hoặc tự tạo</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>create policy "Sales can see their own leads"</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:lastRenderedPageBreak/><w:t xml:space="preserve">  on public.leads for select</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t xml:space="preserve">  using (assigned_to = auth.uid() or created_by = auth.uid());</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>-- 3. Team Lead: Xem lead của thành viên trong nhóm</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>create policy "Team leads can see team leads"</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t xml:space="preserve">  on public.leads for select</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t xml:space="preserve">  using (is_team_lead_of_user(assigned_to));</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>4. QUY TRÌNH XÁC THỰC VÀ LIÊN KẾT TÀI KHOẢN (FLOWS)</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>4.1. Đăng ký/Đăng nhập Email + Mật khẩu</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Người dùng điền Email + Pass -&gt; Gọi supabase.auth.signUp.</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Supabase gửi email xác nhận. Sau khi xác nhận, Trigger on_auth_user_created tự động tạo 1 bản ghi trong bảng profiles.</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Lần sau đăng nhập, hệ thống kiểm tra auth.users và cho phép vào CRM.</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>4.2. Đăng nhập Google OAuth</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Gọi supabase.auth.signInWithOAuth({ provider: 'google' }).</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Google trả về Email và Identity.</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>4.3. Logic Chống Tạo Trùng (Identity Linking)</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Cơ chế: Supabase Auth mặc định sẽ liên kết các Identity (Google, Email/Pass) nếu chúng có cùng địa chỉ Email (với điều kiện email đã được xác nhận).</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Hành động: Khi đăng nhập Google, nếu email đó đã có tài khoản Email/Pass, Supabase sẽ tự động nhận diện đó là User ID hiện tại.</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Đảm bảo Profile: Trigger của chúng ta có câu lệnh on conflict (id) do update. Điều này đảm bảo dù đăng nhập bằng cách nào, user_id vẫn giữ nguyên và chỉ có duy nhất một hồ sơ trong bảng profiles.</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>5. CƠ CHẾ PHÂN QUYỀN THỰC TẾ</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Admin: Kiểm soát bảng profiles để thay đổi Role của nhân viên. Khi Role đổi sang admin, chính sách RLS is_admin() sẽ ngay lập tức mở toàn bộ dữ liệu.</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Trưởng nhóm: Phải được gán là manager_id trong bảng teams và các thành viên phải nằm trong bảng team_members tương ứng. RLS sẽ tự động tính toán quan hệ này để hiển thị dữ liệu.</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Sales: Mọi dữ liệu tạo ra đều mặc định gắn created_by = auth.uid().</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:lastRenderedPageBreak/><w:t>6. SEED DATA MẪU (DỰA TRÊN DESIGN BRIEF)</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>sql</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>-- Tạo các bước Kanban</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>insert into public.pipeline_stages (name, position) values</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>('Mới nhận', 1), ('Đang liên hệ', 2), ('Đã tư vấn', 3), ('Thành công', 4);</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>-- Giả định Admin và Sales đã tồn tại trong auth.users (ID giả định)</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>-- insert into public.leads (full_name, email, phone, company, segment, interest, expected_value)</w:t></w:r></w:p><w:p w:rsidR="00B86E21" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>-- values ('Nguyễn Thị Lan Anh', 'lananh@vingroup.com', '0912345678', 'Vingroup', 'VIP Diamond', '{Trẻ hóa da, Yến sào}', 35000000);</w:t></w:r></w:p><w:p w:rsidR="00A8716F" w:rsidRDefault="00B86E21" w:rsidP="00B86E21"><w:r><w:t>Hệ thống này đảm bảo dù nhân viên của Saigon Smile đăng nhập bằng bất cứ phương thức nào, họ vẫn luôn quay về đúng một hồ sơ công việc duy nhất và không bao giờ thấy dữ liệu của chi nhánh khác nếu không có quyền.</w:t></w:r><w:bookmarkStart w:id="0" w:name="_GoBack"/><w:bookmarkEnd w:id="0"/></w:p><w:sectPr w:rsidR="00A8716F"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>