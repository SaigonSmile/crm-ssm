# ==============================================================
# SAIGON SMILE CRM — Environment Variables Template
# Copy file này thành .env và điền giá trị thực
# Lấy từ: Supabase Dashboard > Project Settings > API
# ==============================================================

# Supabase Project URL (dạng: https://xxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Public, an toàn để dùng trên client)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================
# Cấu hình Vercel: Vào Vercel Dashboard > Project > Settings >
# Environment Variables và thêm 2 biến trên vào Production
# ==============================================================
